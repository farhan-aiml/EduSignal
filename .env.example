# Copy to .env (or set these in your shell / hosting environment). All are optional.
# Never commit real credentials.

# Path to the SQLite database file (default: data/app.db)
EDUSIGNAL_DB_PATH=data/app.db

# Login protection: failed attempts before a temporary lock, and lock length in seconds
EDUSIGNAL_MAX_LOGIN_ATTEMPTS=5
EDUSIGNAL_LOCKOUT_SECONDS=60

# Email notifications are NOT implemented yet; these are placeholders for the EmailChannel stub
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
