# Copy these into your shell or hosting environment (the app reads environment variables).
# All are optional. Placeholders only: never commit real credentials.

# Path to the SQLite database file (default: data/app.db)
EDUSIGNAL_DB_PATH=data/app.db

# Login protection: failed attempts before a temporary lock, and lock length in seconds
EDUSIGNAL_MAX_LOGIN_ATTEMPTS=5
EDUSIGNAL_LOCKOUT_SECONDS=60

# Which alerts also go out by email/SMS: low | medium | high (default high)
NOTIFY_EXTERNAL_MIN_SEVERITY=high

# Email (SMTP). Email is sent only when SMTP_HOST and SMTP_FROM are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls          # starttls | ssl | none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS. Choose a provider: twilio or webhook. SMS is sent only when the provider's settings are complete.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Generic webhook provider: POST JSON {"to": "+91...", "message": "..."}
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
